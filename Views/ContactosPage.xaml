<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AgendaContactos.ViewModels"
             x:Class="AgendaContactos.Views.ContactosPage"
             Title="📒 Mi Agenda"
             BackgroundColor="#F0F4F8">

    <ContentPage.BindingContext>
        <viewmodels:ContactosViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

        <Frame BackgroundColor="#1E3A5F"
               CornerRadius="16"
               Padding="20"
               HasShadow="True"
               BorderColor="Transparent"
               Grid.Row="0">
            <VerticalStackLayout Spacing="4">
                <Label Text="📒 Agenda de Contactos"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="GRUPO #2 - ITLA"
                       FontSize="13"
                       TextColor="#A0C4E8"
                       HorizontalOptions="Center"/>
                <Label Text="{Binding ContadorResultados}"
                       FontSize="14"
                       TextColor="#7FB3D8"
                       HorizontalOptions="Center"
                       Margin="0,6,0,0"/>
            </VerticalStackLayout>
        </Frame>

        <!-- BARRA DE BÚSQUEDA -->
        <Frame BackgroundColor="White"
               CornerRadius="12"
               Padding="4"
               HasShadow="True"
               BorderColor="#E0E0E0"
               Grid.Row="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <Entry Placeholder="🔍 Buscar por nombre, teléfono o email..."
                       Text="{Binding TextoBusqueda}"
                       FontSize="15"
                       BackgroundColor="Transparent"
                       Margin="8,0"/>
                <Button Text="✕"
                        Command="{Binding LimpiarBusquedaCommand}"
                        BackgroundColor="#E74C3C"
                        TextColor="White"
                        CornerRadius="8"
                        WidthRequest="40"
                        HeightRequest="40"
                        FontSize="16"
                        Grid.Column="1"
                        Margin="0,0,4,0"/>
            </Grid>
        </Frame>

        <!-- COLLECTIONVIEW DE CONTACTOS -->
        <CollectionView ItemsSource="{Binding ContactosFiltrados}"
                        SelectedItem="{Binding ContactoSeleccionado}"
                        SelectionMode="Single"
                        Grid.Row="2">

            <!-- EmptyView -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Padding="40">
                    <Label Text="😔"
                           FontSize="60"
                           HorizontalOptions="Center"/>
                    <Label Text="No se encontraron contactos"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#7F8C8D"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0"/>
                    <Label Text="Intenta con otro término de búsqueda"
                           FontSize="14"
                           TextColor="#95A5A6"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- DataTemplate -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White"
                           CornerRadius="14"
                           Padding="14"
                           Margin="0,4"
                           HasShadow="True"
                           BorderColor="#E8EDF2">
                        <Grid ColumnDefinitions="60,*" ColumnSpacing="14">

                            <!-- Avatar -->
                            <Frame BackgroundColor="#EBF5FB"
                                   CornerRadius="30"
                                   WidthRequest="54"
                                   HeightRequest="54"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="#D4E6F1"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Label Text="{Binding Avatar}"
                                       FontSize="28"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>

                            <!-- Datos del contacto -->
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="3">
                                <Label Text="{Binding Nombre}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#2C3E50"/>
                                <Label FontSize="13"
                                       TextColor="#7F8C8D">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="📱 "/>
                                            <Span Text="{Binding Telefono}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label FontSize="13"
                                       TextColor="#7F8C8D">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="📧 "/>
                                            <Span Text="{Binding Email}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- AGREGAR CONTACTO -->
        <Button Text="➕ Agregar Nuevo Contacto"
                Command="{Binding AgregarContactoCommand}"
                BackgroundColor="#27AE60"
                TextColor="White"
                CornerRadius="12"
                FontSize="16"
                FontAttributes="Bold"
                HeightRequest="50"
                Grid.Row="3"
                Margin="0,4,0,8"/>

    </Grid>
</ContentPage>
